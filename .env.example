APP_HOST=0.0.0.0
APP_PORT=5001
# 日志级别(DEBUG 增加事件元数据,不记录消息/工具输出正文);LOG_FILE 置空则不写文件(容器内默认 /app/data/app.log,即宿主机 backend/data/app.log,10MB x 3 轮转)
# 这两项由 logger 直接读环境变量,容器里经 env_file 注入
LOG_LEVEL=INFO

# compose 里固定为 redis,这里的值不生效
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Redis 密码(compose 必填;Redis 端口不再发布到宿主机)
# 用 `openssl rand -hex 24` 生成;留空时 docker compose 会拒绝启动
REDIS_PASSWORD=

# ---- LLM ----
# LLM_PROVIDER: openai | anthropic | deepseek | ollama | vllm | azure
LLM_PROVIDER=openai
LLM_API_KEY=your_api_key
LLM_MODEL_NAME=gpt-4o
# Base URL. Required for deepseek / ollama / vllm / anthropic relays (no guessed defaults:
# the same provider can be the vendor, a relay or your own gateway). Optional only for
# openai (empty -> official endpoint). Examples:
#   openai via relay : https://your-relay.com/v1      (OpenAI SDK needs /v1)
#   anthropic relay  : https://your-relay.com         (no /v1)
#   deepseek         : https://api.deepseek.com       (required, or your relay)
#   ollama           : http://localhost:11434/v1      (required; any key works)
#   vllm             : http://localhost:8000/v1       (required)
# Inside docker compose, localhost means the container itself; use
# http://host.docker.internal:11434/v1 to reach Ollama on the host.
LLM_BASE_URL=
LLM_TEMPERATURE=0.0
# anthropic only: max output tokens per reply (raise it if long files get cut off;
# Claude 3.x models reject values above 8192)
LLM_MAX_TOKENS=8192
# azure only
LLM_API_VERSION=
# 命名配置(可选):LLM_<NAME>_API_KEY / _MODEL_NAME 必填,_BASE_URL / _PROVIDER 可选(PROVIDER 缺省取 NAME)
#   LLM_DEEPSEEK_API_KEY=...        LLM_DEEPSEEK_MODEL_NAME=...
#   LLM_ANTHROPIC_API_KEY=...       LLM_ANTHROPIC_MODEL_NAME=...   LLM_ANTHROPIC_BASE_URL=(不带 /v1)
# 用命名配置作主模型(留空 = 上面的默认 LLM_*),用于不改默认配置做模型对比
LLM_PROFILE=
# 主模型失败(超时 / 5xx / 429 / 鉴权错误)时按顺序切换的命名配置,逗号分隔,如 deepseek,anthropic
LLM_FALLBACKS=

# LangSmith (optional)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deskwork

# ---- 安全 ----
# 后端接受的 API Key,逗号分隔。留空 = 关闭认证(仅限本地开发)。
# 生成: openssl rand -hex 24
API_KEYS=
# 数据按 Key 隔离:每个 Key 是一个独立用户,看不到别人的会话、文件和长期记忆。
# nginx(web 服务)给没带 Key 的请求注入的默认 Key(取 API_KEYS 中的一个):
#   单人使用 -> 填一个,打开页面就能用;
#   多人使用 -> 留空,每人在页面左下角"访问密钥"里填自己的 Key(只存在各自浏览器里)。
# 开启认证前已有的旧数据,启动时会划给 API_KEYS 的第一个 Key。
API_KEY=
# 允许跨域的来源,逗号分隔
CORS_ORIGINS=http://localhost:5173
# Vue 前端(nginx)对外的宿主机端口,默认 8088
WEB_PORT=8088
# 前端绑定地址,默认只对本机开放;nginx 会注入 API_KEY,对外开放前务必先加认证
WEB_BIND=127.0.0.1
# 每个调用方每分钟请求上限;send-message 单独限制
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_SEND_PER_MINUTE=10
# 仅当后端只经可信反代访问时设为 true(docker compose 里已为 backend 开启):按 X-Real-IP 区分调用方
TRUST_PROXY_HEADERS=false
# 单次 send-message 的上传限制:文件数 / 单文件 MB / 总 MB(超限返回 413)
UPLOAD_MAX_FILES=20
UPLOAD_MAX_FILE_MB=50
UPLOAD_MAX_TOTAL_MB=100

# 沙箱资源配额(按会话),0 = 不限制
SESSION_MAX_STORAGE_MB=1024
SESSION_MAX_FILE_MB=200
MAX_CONCURRENT_RUNS=4
# 空闲 bash shell 回收:空闲秒数 / 同时存活上限(应小于 sandbox-manager 的 MANAGER_MAX_SPAWN=32),0 = 不限制
SANDBOX_SHELL_IDLE_SEC=900
SANDBOX_MAX_SHELLS=24
# 回退重发时恢复沙箱文件:每会话保留的回合快照数(0 关闭)与单次快照大小上限(MB,超出则跳过)
SNAPSHOT_KEEP=3
SNAPSHOT_MAX_MB=300
# 本轮结束后后台预转换新交付的 Office 文件为 PDF,让预览秒开(false 关闭)
PREVIEW_PREWARM=true
# 单轮对话预算(0 = 不限制):模型调用次数 / 累计 token / 同一工具调用连续重复次数
AGENT_MAX_LLM_CALLS=60
AGENT_MAX_TOTAL_TOKENS=2000000
AGENT_MAX_REPEATED_CALLS=4
# 子 Agent 单次委派的模型调用上限(0 = 不限制);上面的预算统计不到子 Agent 内部
SUBAGENT_MAX_LLM_CALLS=15
# 对话摘要:token 或消息数超过任一阈值就压缩早期消息(用主模型),保留最近 N 条原文
SUMMARY_TRIGGER_TOKENS=72000
SUMMARY_TRIGGER_MESSAGES=100
SUMMARY_KEEP_MESSAGES=20
# 给读取外部内容的工具结果加 <untrusted_content> 边界标记(注入防御,关闭后可做前后对照评测)
UNTRUSTED_BOUNDARY=true
# 高风险 bash 命令(rm、覆盖上传文件等)执行前向用户确认(子 Agent 发起的也会问)
CONFIRM_RISKY_COMMANDS=true
# Anthropic 模型的 prompt caching;其他 provider 自动忽略
PROMPT_CACHING=true
# 向量检索(search_document 的混合检索):OpenAI 兼容的 /embeddings 接口,如硅基流动。
# 留空 = 只用 BM25。启用后被检索文档的段落文本会发送到该服务。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MAX_CHUNKS=2000
# 多 Agent 分工:开启后注册只读的规划者 / 审查者子 Agent(默认关)
MULTI_AGENT=false
# 工具权限分级(JSON:工具名 -> allow|confirm|deny),留空 = 不额外限制
TOOL_POLICY=

# ---- 持久化 ----
# DATA_DIR 留空 = backend/data;DATABASE_URL 留空 = 使用 DATA_DIR 下的 SQLite
DATA_DIR=
DATABASE_URL=

# sandbox-manager 的访问令牌(后端 -> manager),必填
# 用 `openssl rand -hex 24` 生成;留空时 docker compose 会拒绝启动
SANDBOX_MANAGER_TOKEN=

# 产物自检:docx/pptx/xlsx/pdf 生成后渲染成图片,由多模态模型检查排版并让 Agent 修复。
# 填命名 profile(需支持图片输入,如 anthropic);留空 = 不启用。会额外消耗审阅模型的 token。
REVIEW_LLM_PROFILE=
# 同一个视觉模型也用于 view_image 工具(看用户上传的截图/图片);留空 = 不启用,Agent 无法看图。
# 单张图片大小上限(MB)与每轮最多调用次数:
VIEW_IMAGE_MAX_MB=5
VIEW_IMAGE_MAX_PER_TURN=5

# 长期记忆(默认关闭):开启后 Agent 可保存/查询/删除跨会话的偏好与事实。
# 记忆按 API Key 隔离,同一 Key 的所有会话共享;写入默认需要你确认,防止上传文档里的注入指令污染记忆。
MEMORY_ENABLED=false
MEMORY_DEFAULT_TTL_DAYS=180
MEMORY_MAX_ITEMS=200
MEMORY_CONFIRM_WRITES=true

# 联网搜索 / 抓取(web_search / web_fetch),调用 DeepSeek Search & Fetch API,留空=不启用。
# 可以和 LLM_DEEPSEEK_API_KEY 用同一个 Key;按成功请求计费,两者各约 $0.75 / 1000 次,失败和空结果不计费。
# 搜索词和要抓的 URL 会发给 DeepSeek。抓取不是你给的、也不在搜索结果里的网址前会先问你。
WEB_TOOLS_API_KEY=
# 一般不用改:接口地址与单次请求超时(秒)
# WEB_TOOLS_BASE_URL=https://api.deepseek.com
# WEB_TOOLS_TIMEOUT=60
# WEB_MAX_CALLS_PER_TURN=10
# WEB_FETCH_MAX_CHARS=20000
# WEB_FETCH_CONFIRM_UNKNOWN=true

# 接入外部 MCP 服务器(JSON,单行),留空=不启用。stdio 命令在后端容器内运行,由部署者负责可信。
# MCP_SERVERS={"files":{"transport":"http","url":"http://host.docker.internal:8000/mcp"}}
# 网页抓取也可以用官方 mcp-server-fetch(默认拒绝内网地址;已配 WEB_TOOLS_API_KEY 时不需要)。后端容器启动时由 uvx 下载,实测约 19 秒,
# 接近默认的 MCP_CONNECT_TIMEOUT=20,启用时把它调到 60;每次调用另起进程,约 2-4 秒:
# MCP_SERVERS={"fetch":{"transport":"stdio","command":"uvx","args":["mcp-server-fetch==2026.10.28"]}}
MCP_SERVERS=
MCP_CONNECT_TIMEOUT=20
# 外部工具调用前需要你确认,除非它声明只读(readOnlyHint=true)且不访问外部(openWorldHint=false)。
# 抓取网页、搜索这类只读但联网的工具也要确认,因为它们能把数据带出断网的沙箱;
# 确定信任某个工具时,用 TOOL_POLICY 把它设为 allow,例如 {"fetch_fetch":"allow"}
MCP_CONFIRM_TOOLS=true

# ---- 构建 ----
# 沙箱镜像安装 Python 包用的索引;官方 PyPI 慢时可改为 https://pypi.tuna.tsinghua.edu.cn/simple
PIP_INDEX_URL=https://pypi.org/simple
